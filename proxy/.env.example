# Copy to .env and replace both values (letters/digits only).
# TOKEN becomes part of every URL on the Dreamcast; anyone without it gets 404.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(6))"
TOKEN=change-me
# Password of the web page http://<server>:8765/admin (any user name).
# Leave empty to disable the page. Plain HTTP: use it on your LAN.
ADMIN_PASSWORD=
