# Profile that played best on a real Dreamcast (dcplaya 2.0b2 over W5500/BBA).
# Change one value at a time and test on the console, then: docker compose up -d
FPS=15
WIDTH=192
HEIGHT=144
VBITRATE=150k
GOP=30
VBUFSIZE=1000k
VENC_EXTRA=-qmin 2
VDENOISE=
VDEINT=
ACODEC=libmp3lame
ABITRATE=128k
ACHANNELS=2
ASRATE=44100
MUXRATE=600k
PACE=1.25
