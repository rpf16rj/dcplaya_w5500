# Profile that played best on a real Dreamcast (dcplaya 2.0b2 over W5500/BBA).
# Change one value at a time and test on the console, then: docker compose up -d
FPS=15
WIDTH=192
HEIGHT=144
VBITRATE=150k
GOP=30
VBUFSIZE=1000k
VENC_EXTRA=-qmin 2
VDEINT=
ACODEC=libmp3lame
ABITRATE=128k
ACHANNELS=2
ASRATE=44100
MUXRATE=600k
PACE=1.25
# Defaults also in effect (server.py): VSCALER=area, VDENOISE=gblur=sigma=0.5,
# AFILTER=loudnorm=I=-14:TP=-1.5:LRA=11, YT_LIST_MAX=25, YT_REFRESH_HOURS=24
